{
  "compilerOptions": {
    "types": ["node"],
    "jsx": "react-jsx",
    "target": "es2023",
    "strict": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["apps", "packages", "skill", "scripts"]
}
